{
  "realm": "medetherial",
  "enabled": true,
  "displayName": "MedEtherial",
  "displayNameHtml": "<b>Med</b>Etherial",
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(8) and digits(1) and upperCase(1) and lowerCase(1) and notUsername",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "loginTheme": "keycloak.v2",
  "accountTheme": "keycloak.v3",
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "REGISTER",
    "UPDATE_PASSWORD",
    "CODE_TO_TOKEN_ERROR"
  ],
  "roles": {
    "realm": [
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "patient",
        "description": "Patient \u2014 books appointments, views own records, raises SOS"
      },
      {
        "name": "doctor",
        "description": "Doctor \u2014 manages schedule, writes notes and prescriptions"
      },
      {
        "name": "paramedic",
        "description": "Paramedic \u2014 ambulance crew, publishes GPS, updates incidents"
      },
      {
        "name": "dispatcher",
        "description": "Dispatcher \u2014 monitors fleet, assigns incidents"
      },
      {
        "name": "hospital_admin",
        "description": "Hospital administrator \u2014 manages ER capacity"
      },
      {
        "name": "admin",
        "description": "Platform administrator"
      },
      {
        "name": "default-roles-medetherial",
        "description": "Default roles for new users",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "patient"
          ]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-medetherial",
    "description": "Default roles for new users",
    "composite": true
  },
  "clients": [
    {
      "clientId": "medetherial-web",
      "name": "MedEtherial Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_WEB_CLIENT_SECRET:dev-web-client-secret}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${WEB_URL:http://localhost:3000}/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "${WEB_URL:http://localhost:3000}",
        "http://localhost:3000"
      ],
      "rootUrl": "${WEB_URL:http://localhost:3000}",
      "baseUrl": "/",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${WEB_URL:http://localhost:3000}/*##http://localhost:3000/*",
        "frontchannel.logout": "false",
        "backchannel.logout.session.required": "true"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "medetherial-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "medetherial-api",
      "name": "MedEtherial API (resource server)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "medetherial-api-admin",
      "name": "MedEtherial API admin service account",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_ADMIN_CLIENT_SECRET:dev-admin-client-secret}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
