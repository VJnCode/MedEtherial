# --- Auth.js (OIDC with Keycloak) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_KEYCLOAK_ID=medetherial-web
AUTH_KEYCLOAK_SECRET=dev-web-client-secret
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/medetherial

# --- API ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- UI ---
# Show "Continue with Google" (requires the Google identity provider in Keycloak)
NEXT_PUBLIC_GOOGLE_SIGNIN=true
# Show demo account e-mails on the sign-in page
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true
# Link to the Keycloak account console (password, sessions, 2FA)
NEXT_PUBLIC_KEYCLOAK_ACCOUNT_URL=http://localhost:8080/realms/medetherial/account
