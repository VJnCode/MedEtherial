# --- Server ---
NODE_ENV=development
PORT=8000
LOG_LEVEL=info
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# --- Database (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medetherial?retryWrites=true&w=majority

# --- OIDC (Keycloak) ---
OIDC_ISSUER=http://localhost:8080/realms/medetherial
# Optional: override when the API reaches Keycloak on a different host than the browser (e.g. docker)
OIDC_JWKS_URI=
OIDC_AUDIENCE=medetherial-api
# Optional: Keycloak base URL for server-to-server calls when it differs from the public one
KEYCLOAK_INTERNAL_URL=

# Service-account client used to manage user roles via the Keycloak Admin REST API
KEYCLOAK_ADMIN_CLIENT_ID=medetherial-api-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-admin-secret

# --- Routing (OSRM, open source) ---
OSRM_URL=https://router.project-osrm.org

# Timezone used for doctor availability windows
CLINIC_TIMEZONE=Asia/Kolkata

# --- Simulator ---
SIMULATOR_ENABLED=true
SIMULATOR_TICK_MS=2000
SIMULATOR_AUTO_INCIDENTS=false
